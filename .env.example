# Copy this file to .env.local for local development.
# On Railway, add the same names in the service Variables tab.

# Required. From https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=

# Required. From https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Frozen default for the public lab. The UI can also run gpt-4.1-mini and gpt-5.6-sol.
LLM_MODEL=gpt-4.1
JEV_MODEL=jev-latest

# USD per 1M tokens. UI cost uses the per-model table in src/lib/options.ts.
# GPT-4.1: $2 / $8. GPT-4.1 mini: $0.40 / $1.60. GPT-5.6 Sol: $4 / $20.
# Jev: $0.042 input / $0 output (TypeSafe, per Btok $42).
OPENAI_INPUT_PRICE_PER_MTOK=2
OPENAI_OUTPUT_PRICE_PER_MTOK=8
JEV_INPUT_PRICE_PER_MTOK=0.042
JEV_OUTPUT_PRICE_PER_MTOK=0
PRICING_AS_OF=2026-09-20

# Public-app guards
DAILY_COST_CEILING_USD=5
MAX_BENCHMARK_SIZE=100
MAX_INPUT_CHARS=500
COMPARE_TIMEOUT_MS=45000
BENCHMARK_CONCURRENCY=3

# Production URL prefix. Leave empty for local `http://localhost:3000`.
# On Railway set this to /how-good-is-jev (build + runtime).
NEXT_PUBLIC_BASE_PATH=
